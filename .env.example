# Copy to `.env` on the server, next to docker-compose.yml, then:
#   chmod 600 .env
# Docker Compose reads it automatically. Never commit the real .env.
# Every variable is explained in ENVIRONMENT.md.

# Required
ADMIN_PASSWORD=change-me-to-a-long-random-password
# POSTGRES_PASSWORD: on an EXISTING install, keep exactly the value the
# database was created with (if you never set one, that is `kayayiti`, so
# leave this line out). Postgres only applies it on first creation — a new
# value here would lock the app out of its own database.
# POSTGRES_PASSWORD=

# SMS notifications via Twilio (optional; leave empty to turn off)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_SMS_FROM=

# Scheduled jobs (visit reminders + deleting sold/leased homes).
# Generate one, e.g.:  openssl rand -hex 32
# Without it the /api/cron endpoint stays closed and nothing is scheduled.
CRON_SECRET=

# Optional
ADMIN_SESSION_SECRET=
EMAIL_FROM=
RESEND_API_KEY=
